Configs: {
	InventorySoundsConfig: {
		DisplayName: Inventory Sounds Config

		useItemSwapSounds: {
			Label: Use Sounds on Item Change
			Tooltip: Have this set to 'On' if you want to hear sounds while changing held items.
		}

		volumeMultiplier: {
			Label: Sound Multiplier
			Tooltip: Change the master volume of inventory sounds.
		}

		enabledDynamicSoundsSystem: {
			Label: Dynamic Inventory Sounds
			Tooltip:
				'''
				Whether or not the dynamic inventory sounds system is enabled or not.
				If disabled, regular 'grab' sounds will be used.
				'''
		}
	}

	AudioConfig: {
		DisplayName: Audio Config

		Headers: {
			SoundEffects: Sound Additions
			SoundFilters: Sound Filters
		}

		campfireSounds: {
			Label: Toggle Campfire Volumetric Sound
			Tooltip:
				'''
				Toggle on to turn campfire sounds on. Toggle off to turn them off.
				Turned on by default.
				'''
		}

		craftingSoundsVolume: {
			Label: Crafting Sounds Volume
			Tooltip: Changes the volume multiplier of the sounds made when a player crafts an item. Set to 0 to disable.
		}

		slimySounds: {
			Label: Slimy Sounds
			Tooltip: Toggle the sounds that slimes create when jumping and landing.
		}

		woodCreaks: {
			Label: Wood Creaks
			Tooltip:
				'''
				Toggle the sounds that slightly unsupported wood make.
				Do note that this can potentially increase FPS, as this can be a hefty process.
				'''
		}

		dynamicAnimalSounds: {
			Label: Various Animal Sounds
			Tooltip: Toggle the (somewhat loud) sounds that play and have dynamic sound updating based on location-to-player panning.
		}

		chestSounds: {
			Label: Container Sounds
			Tooltip:
				'''
				If enabled, certain containers will play sounds when opened/closed.
				This config is shared with everyone in the server.
				'''
		}

		newSplashSounds: {
			Label: New Splash Sounds
			Tooltip:
				'''
				Toggle on to turn this mod's new water interaction sounds on. Toggle off to turn them off.
				Turned on by default.
				This config is shared with everyone in the server.
				'''
		}

		isReverbEnabled: {
			Label: Reverb
			Tooltip: Makes sounds have a reverberation factor depending on environment or depth, depending on what settings for reverb you have enabled.
		}

		reverbUsingRaycasting: {
			Label: Reverb Raycasting
			Tooltip:
				'''
				If enabled, reverb will use an immensely more accurate approach to calculating reverb.
				If Reverb is disabled, this setting changes nothing.
				Be aware that enabling this comes at a sizable performance cost.
				'''
		}

		audioFiltersRefreshTime: {
			Label: Audio Filters Refresh Time
			Tooltip:
				'''
				The time (in ticks) between updating calculating properties of all sound filters.
				Lower values are more intensive on the CPU, and higher values have the opposite effect.
				'''
		}

		advancedReverbCalculation: {
			Label: Advanced Reverb
			Tooltip:
				'''
				Toggle advanced audio reverb calculation algorithms. This setting does nothing if "Reverb" is disabled.
				Disabling this will increase your reverb factor by how deep you are into the world.
				Having this disabled will make reverb apply as a scalar and not dynamically, such as sounding more spacious in bigger rooms.
				'''
		}

		isSoundDampeningEnabled: {
			Label: Sound Dampening
			Tooltip: Makes sounds sound dampened when appropriate (i.e: underwater).
		}

		isSoundOcclusionEnabled: {
			Label: Sound Occlusion
			Tooltip: Makes sounds muffled when the Line-of-Sight to the player is blocked, depending on distance and density of the blockage.
		}

		reverbMaxArea: {
			Label: Reverb Max Area
			Tooltip:
				'''
				The maximum area (in tiles/blocks) the reverb/rooms system can occupy, centering at the player's head.
				You can set this value higher for a more realistic sound feel for larger rooms, but also comes with an increasingly larger computational cost.
				If "Reverb Raycasting" is enabled, this setting becomes more computationally expensive, and should be kept at a reasonable value.
				If "Advanced Reverb" is disabled, this setting does nothing.
				A value of 2500 is good for most computers, but can be a little small. 5000 is large and can cause framerate issues on weaker systems.
				'''
		}

		runSoundsEnabled: {
			Label: Running Sounnds
			Tooltip: The toggle for the Vanilla "Running" sound when using boots (i.e: Hermes)
		}
	}

	FootstepsConfig: {
		DisplayName: Footsteps Config

		entityFootstepsVolume: {
			Label: Entity Footsteps Volume
			Tooltip:
				'''
				Sets the volume of footstep audio for numerous NPCs, including Town NPCs, Zombies, and more.
				Set to 0 to disable.
				'''
		}

		masterFootstepsVolume: {
			Label: Footsteps Volume
			Tooltip: Controls master volume of footsteps. Set to zero to disable them.
		}

		wetStepsEnabled: {
			Label: Wet Steps
			Tooltip:
				'''
				Whether or not to have wet footstep sounds when it is raining and the player is not under a roof.
				Do know that there is a *little* bit of performance gain from disabling this.
				'''
		}

		areArmorAndVanitySoundsEnabled: {
			Label: Armor/Vanity Sounds
			Tooltip: Determines whether or not the extra sounds that having armor/vanity equipped play when walking around.
		}
	}

	AmbientConfig: {
		DisplayName: Ambience Config

		Headers: {
			Debugging: Debugging
			AmbienceTrackVolumes: Fine-Tuning
			RealTimeTweaks: Real-Time Tweaks
		}

		debugInterface: {
			Label: Toggle Debug
			Tooltip: Toggle volume debugging values, such as snow, crickets, and more.
		}

		showInfoAndWarnings: {
			Label: Show Info/Warnings
			Tooltip:
				'''
				Whether or not to display important information and warnings to the chat when problematic errors occur.
				Having this disabled can remove small annoyances, but can make it hard to identify what is destroying your game's performance.
				Enable this option if you are having severe framerate drops to see if any errors are being spammed into the chat.
				'''
		}

		overallVolume: {
			Label: Master Volume
			Tooltip: The master volume of ambience from this mod.
		}

		transitionHarshness: {
			Label: Ambient Transition Speed
			Tooltip:
				'''
				Changes the harshness between ambient track transitions. Keep it low for a nice, soothing transition.
				Put it closer to 1 and make it near-instant.
				Anywhere under 0.075 is a good value.
				Making it go too low can cause issues or make things a bit unwanted. Choose the value at your own risk!
				DISCLAIMER: Making this input a non-floating-point numeric type will cause the value to default to 0.01.
				'''
		}

		forestVolumes: {
			Label: Forest
			Tooltip:
				'''
				Order: Top -> Bottom

				Morning
				Afternoon
				Evening
				Night
				'''
		}

		snowVolume: {
			Tooltip: ""
			Label: Tundra
		}

		jungleVolumes: {
			Label: Jungle
			Tooltip:
				'''
				Order: Top -> Bottom

				SurfaceDay
				SurfaceNight
				UndergroundDay
				UndergroundNight
				'''
		}

		evilVolumes: {
			Label: World Evils
			Tooltip:
				'''
				Order: Top -> Bottom

				Corruption
				Crimson
				'''
		}

		desertVolume: {
			Label: Desert
			Tooltip: ""
		}

		oceanVolume: {
			Label: Ocean
			Tooltip: ""
		}

		cavernsVolume: {
			Label: Caverns
			Tooltip: ""
		}

		hellVolume: {
			Label: Hell
			Tooltip: ""
		}

		breezeVolume: {
			Label: Breeze
			Tooltip: ""
		}

		underwaterVolume: {
			Label: Submerged
			Tooltip: ""
		}

		bossFightMusicAdjust: {
			Label: Bossfight Music Adjust
			Tooltip: If enabled, the mod will increase the music volume (gradually) to the 'Bossfight Music Adjust On' when a boss is active, and 'Bossfight Music Adjust Off' otherwise.
		}

		bossFightMusicVolume: {
			Label: Bossfight Music Adjust On
			Tooltip: If 'Bossfight Music Adjust' is enabled, the music volume will slowly go up to this value if a boss is active.
		}

		bossFightMusicMin: {
			Label: Bossfight Music Adjust Off
			Tooltip: If 'Bossfight Music Adjust' is enabled, the music volume will slowly go down to this value if no boss is active
		}
	}

	UIConfig: {
		DisplayName: UI Config

		Headers: {
			MainMenu: Main Menu
			In-game: In-game
		}

		showMainMenuUi: {
			Label: Show Main Menu UI
			Tooltip: Whether or not to show the Discord server promotion/disclaimer on the main menu.
		}

		showAmbientForecastUi: {
			Label: Show Ambient Forecast UI
			Tooltip: Whether or not to display the ambient forecast UI near the hotbar.
		}
	}
}

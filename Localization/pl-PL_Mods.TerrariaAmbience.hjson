Configs: {
	AmbientConfigServer: {
		DisplayName: Konfiguracja otoczenia (Serwer)

		chestSounds: {
			Label: Dźwięki otwierania/zamykania Skrzyni
			Tooltip:
				'''
				Włącz, aby włączyć dźwięki otwierania skrzyń. Wyłącz, aby je wyłączyć.
				Domyślnie włączone.
				Ta konfiguracja jest udostępniona wszystkim na serwerze.
				'''
		}

		newSplashSounds: {
			Label: Nowe dźwięki wody
			Tooltip:
				'''
				Włącz, aby aktywować nowe dźwięki interakcji z wodą w tej modyfikacji.Wyłącz, aby je wyłączyć.
				Domyślnie włączone.
				Ta konfiguracja jest udostępniona wszystkim na serwerze.
				'''
		}
	}

	AudioAdditionsConfig: {
		DisplayName: Konfiguracja dodatków dźwiękowych

		slimySounds: {
			Label: Oślizgłe dźwięki
			Tooltip: Przełącz dźwięki, które wydają slimaki podczas skakania i lądowania.
		}

		woodCreaks: {
			Label: Skrzypienie drewna
			Tooltip:
				'''
				Przełącz dźwięki, które wydaje lekko niewsparte drewno. 
				Należy zauważyć, że może to potencjalnie zwiększyć liczbę klatek na sekundę, ponieważ może to być wymagający proces.
				'''
		}

		dynamicAnimalSounds: {
			Label: Różnorodne dźwięki zwierząt
			Tooltip: Przełącz dźwięki (dość głośne), które odtwarzają się i mają dynamiczne aktualizacje dźwięku na podstawie lokalizacji w stosunku do gracza.
		}

		Headers: {
			SoundFilters: Filtry dźwięku
			// NewSounds: New Sounds Header
		}

		isReverbEnabled: {
			Label: Pogłos
			Tooltip: Sprawia, że dźwięki mają współczynnik pogłosu zależny od środowiska lub głębokości, w zależności od ustawień pogłosu, które masz włączone.
		}

		advancedReverbCalculation: {
			Label: Zaawansowane obliczenia pogłosu
			Tooltip:
				'''
				Przełącz zaawansowane algorytmy obliczania pogłosu.
				Wyłączenie tego zwiększy współczynnik pogłosu w zależności od tego, jak głęboko jesteś.
				'''
		}

		isSoundDampeningEnabled: {
			Label: Tłumienie dźwięku
			Tooltip: Sprawia, że dźwięki są tłumione pod wodą.
		}

		isSoundOcclusionEnabled: {
			Label: Okluzja dźwięku
			Tooltip: Sprawia, że dźwięki stają się przytłumione, gdy linia widzenia gracza jest zablokowana, w zależności od odległości i gęstości blokady.
		}

		floodFillAmbientOcclusion: {
			// Label: Flood Fill Audio Adaption
			/* Tooltip:
				'''
				Ambience will lower in volume if you are in a room with this setting enabled.
				Disabling this setting can improve performance.
				''' */
		}

		audioFiltersRefreshTime: {
			// Label: Audio Filters Refresh Time
			/* Tooltip:
				'''
				The time (in ticks) between updating calculating properties of all sound filters.
				Lower values are more intensive on the CPU, and higher values have the opposite effect.
				''' */
		}
	}

	GeneralConfig: {
		DisplayName: Konfiguracja ogólna

		Headers: {
			AmbienceAndSounds: Otoczenie i dźwięki
			Debugging: Debugowanie
			// AmbienceTrackVolumes: Ambience Fine-Tuning
		}

		campfireSounds: {
			Label: Przełącz wolumetryczne dźwięki ogniska
			Tooltip:
				'''
				Włącz, aby włączyć dźwięki ogniska. Wyłącz, aby je wyłączyć.
				Domyślnie włączone.
				'''
		}

		transitionHarshness: {
			Label: Intensywność przejścia otoczenia
			Tooltip:
				'''
				Zmienia intensywność między przejściami ścieżek dźwiękowych otoczenia. Zachowaj ją na niskim poziomie, aby uzyskać przyjemne i łagodne przejście. 
				Ustawienie bliżej 1 sprawi, że przejście będzie niemal natychmiastowe. 
				Wartość poniżej 0.075 jest dobrym wyborem.
				Ustawienie zbyt niskiej wartości może powodować problemy lub niepożądane efekty. Zmieniasz wartość na własne ryzyko! 
				UWAGA: Ustawienie tego na typ liczbowy inny niż zmiennoprzecinkowy spowoduje, że wartość domyślna wyniesie 0,01.
				'''
		}

		areArmorAndVanitySoundsEnabled: {
			Label: Dźwięki pancerza/próżności
			Tooltip: Określa, czy podczas chodzenia będą odtwarzane dodatkowe dźwięki związane z posiadaniem pancerza/próżności.
		}

		debugInterface: {
			Label: Przełącz wartości debugowania (Podstawowe otoczenie)
			Tooltip: Przełącz wartości debugowania głośności, takie jak śnieg, świerszcze i inne.
		}

		overallVolume: {
			Label: Ogólna głośność
			Tooltip: Ogólna głośność otoczenia z tego moda.
		}

		wetStepsEnabled: {
			Label: Mokre kroki
			Tooltip:
				'''
				Włączenie lub wyłączenie dźwięków mokrych kroków, gdy pada deszcz, a gracz znajduje się pod dachem.
				Należy pamiętać, że wyłączenie tej opcji powoduje *niewielki* wzrost wydajności.
				'''
		}

		forestVolumes: {
			Label: Las
			Tooltip:
				'''
				Order: Góra -> Dół

				Poranek
				Popołudnie
				Wieczór
				Noc
				'''
		}

		snowVolume: {
			Tooltip: ""
			Label: Śnieg
		}

		jungleVolumes: {
			Label: Dżungla
			Tooltip:
				'''
				Order: Góra -> Dół

				Dzień na powierzchni
				Noc na powierzchni
				Dzień pod ziemią
				Noc pod ziemią
				'''
		}

		evilVolumes: {
			Label: Zło na świecie
			Tooltip:
				'''
				Order: Góra -> Dół

				Zepsucie
				Szkarłat
				'''
		}

		desertVolume: {
			Label: Pustynia
			Tooltip: ""
		}

		oceanVolume: {
			Label: Ocean
			Tooltip: ""
		}

		cavernsVolume: {
			Label: Jaskinie
			Tooltip: ""
		}

		hellVolume: {
			Label: Piekło
			Tooltip: ""
		}

		breezeVolume: {
			Label: Bryza
			Tooltip: ""
		}

		underwaterVolume: {
			Label: Zanurzony
			Tooltip: ""
		}

		craftingSoundsVolume: {
			Label: Głośność Dźwięków Tworzenia
			Tooltip: Zmienia mnożnik głośności dźwięków wydawanych podczas tworzenia przedmiotu przez gracza. Ustaw na 0, aby wyłączyć.
		}

		footstepsVolMult: {
			// Label: Footsteps Volume
			// Tooltip: Controls volume multiplier of footsteps. Set to zero to not hear any.
		}

		entityFootstepsVolume: {
			// Label: Entity Footsteps Volume
			/* Tooltip:
				'''
				Sets the volume of footstep audio for numerous NPCs, including Town NPCs, Zombies, and more.
				Set to 0 to disable.
				''' */
		}

		showAmbientForecastUi: {
			// Label: Show Ambient Forecast UI
			// Tooltip: Enables/disables the ambient forecast UI next to the hotbar
		}

		showInfoAndWarnings: {
			// Label: Show Info And Warnings
			/* Tooltip:
				'''
				Whether or not this mod will report important informationt to the chat when information is needed or things go wrong.
				Do note that, if by any chance things go wrong and continually go wrong, your FPS will drop significantly.
				In the case that this happens, be sure to enable this setting to see what is going on, and report any issues to the Discord server.
				''' */
		}
	}

	InventorySoundsConfig: {
		// DisplayName: Inventory Sounds Config

		useItemSwapSounds: {
			// Label: Use Sounds on Item Change
			// Tooltip: Have this set to 'On' if you want to hear sounds while changing held items.
		}

		volumeMultiplier: {
			// Label: Sound Multiplier
			// Tooltip: Change the overall volume of inventory sounds.
		}

		enabledDynamicSoundsSystem: {
			// Label: Dynamic Inventory Sounds
			/* Tooltip:
				'''
				Whether or not the dynamic inventory sounds system is enabled or not.
				If disabled, regular 'grab' sounds will be used.
				''' */
		}
	}

	UIConfig: {
		// DisplayName: UI Config

		Headers: {
			// MainMenu: Main Menu
			// In-game: In-game
		}

		showMainMenuUi: {
			// Label: Show Main Menu UI
			// Tooltip: Whether or not to show the Discord server promotion/disclaimer on the main menu.
		}

		showAmbientForecastUi: {
			// Label: Show Ambient Forecast UI
			// Tooltip: Whether or not to display the ambient forecast UI near the hotbar
		}
	}
}
